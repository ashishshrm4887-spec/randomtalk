{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "randomtalk-app",
  "main": "src/index.js",
  "compatibility_date": "2026-08-12",

  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT",
        "class_name": "ChatRoom"
      }
       "secrets_store_secrets": [
  {
    "binding": "ADMIN_PASSWORD",
    "store_id": "b1352070fd2b4da592ab114f41225389",
    "secret_name": "admin_password"
  }
],

    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatRoom"]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    }
  }
}
